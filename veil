#!/usr/bin/env bash
# veil — управление ключами и подписками veil-ноды.
# create-key | delete-key | list-keys | show-key | update | status
set -euo pipefail

CONF=/usr/local/etc/xray/config.json
VEIL=/etc/veil
META=$VEIL/server.env
USERS=$VEIL/users.json
SUBDIR=$VEIL/sub
GENPROF=$VEIL/genprofile.py
GENSERVER=$VEIL/genserver.py
RED='\033[0;31m'; GREEN='\033[0;32m'; YEL='\033[1;33m'; CY='\033[0;36m'; BOLD='\033[1m'; NC='\033[0m'
die(){ echo -e "${RED}ERR:${NC} $*" >&2; exit 1; }

[ "$(id -u)" = "0" ] || die "запусти от root"
for f in "$CONF" "$META" "$USERS" "$GENPROF" "$GENSERVER"; do [ -f "$f" ] || die "нет $f — сначала install.sh"; done
command -v jq >/dev/null || die "нужен jq"
# shellcheck disable=SC1090
. "$META"

qr(){ if command -v qrencode >/dev/null; then qrencode -t ANSIUTF8 "$1"; fi; }

sub_link(){ echo "https://${SUB_HOST}/sub/$1"; }

# url-кодирование значения для query (кодируем '/' в path и прочие спецсимволы)
urlenc(){
  local s="$1" out="" c i
  for (( i=0; i<${#s}; i++ )); do
    c="${s:$i:1}"
    case "$c" in
      [a-zA-Z0-9.~_-]) out+="$c";;
      *) printf -v c '%%%02X' "'$c"; out+="$c";;
    esac
  done
  printf '%s' "$out"
}

# два «голых» vless://-ключа (Обычный + Усиленный) по UUID юзера.
# ВНИМАНИЕ: share-ссылка не несёт routes (РУ-сплит) и packet-up/xmux extra —
# это упрощённый импорт без РУ-обхода. Полный профиль — только через подписку.
vless_links(){   # $1=uuid (имя ключа не выводим в метку — бренд фиксированный «🌐 VPN»)
  local uuid="$1" sni pbk
  sni=$(urlenc "$SNI"); pbk=$(urlenc "$PBK")
  echo "vless://${uuid}@${SRV_IP}:${PORT_OB}?encryption=none&security=reality&sni=${sni}&fp=chrome&pbk=${pbk}&sid=${SID_OB}&type=xhttp&path=$(urlenc "$PATH_OB")&mode=packet-up#$(urlenc "🌐 VPN · Обычный")"
  echo "vless://${uuid}@${SRV_IP}:${PORT_US}?encryption=none&security=reality&sni=${sni}&fp=chrome&pbk=${pbk}&sid=${SID_US}&type=xhttp&path=$(urlenc "$PATH_US")&mode=auto#$(urlenc "🌐 VPN · Усиленный")"
}

show_all(){   # $1=token $2=name $3=uuid — подписка + два vless-ключа, у каждого свой QR
  local link; link=$(sub_link "$1")
  echo
  echo -e "${CY}${BOLD}🌐 VPN — подписка (рекомендуется: РУ-сайты мимо VPN + авто-обновление):${NC}"
  echo "$link"
  qr "$link"
  echo
  echo -e "   2 профиля: [Обычный] моб.интернет | [Усиленный] Wi-Fi/жёсткий DPI."
  echo
  echo -e "${CY}${BOLD}Либо два отдельных vless-ключа (быстрый импорт, БЕЗ РУ-сплита):${NC}"
  while IFS= read -r k; do
    [ -n "$k" ] || continue
    echo
    echo "$k"
    qr "$k"
  done < <(vless_links "$3")
  echo
}

key_exists(){ jq -e --arg n "$1" 'has($n)' "$USERS" >/dev/null 2>&1; }

write_json(){ cat "$1" > "$2"; rm -f "$1"; }   # сохраняет права целевого файла

regen_one(){   # $1=uuid $2=token
  local tmp; tmp=$(mktemp)
  VEIL_ENV="$META" VEIL_ROUTES="$VEIL/routes.json" python3 "$GENPROF" "$1" > "$tmp"
  install -m 644 "$tmp" "$SUBDIR/$2"; rm -f "$tmp"
}

reload_xray(){
  xray run -test -c "$CONF" >/dev/null 2>&1 || die "конфиг сломан, Xray НЕ перезапущен"
  systemctl restart xray; sleep 1
  systemctl is-active --quiet xray || die "Xray не стартовал (journalctl -u xray)"
}

# заменить значение KEY=val в server.env (или добавить)
set_env_var(){   # $1=key $2=val
  local tmp; tmp=$(mktemp)
  if grep -q "^$1=" "$META"; then sed "s|^$1=.*|$1=$2|" "$META" > "$tmp"
  else cp "$META" "$tmp"; echo "$1=$2" >> "$tmp"; fi
  cat "$tmp" > "$META"; rm -f "$tmp"
}

# согласованно применить: сервер + все клиентские профили + рестарт.
# ИСТОЧНИК ИСТИНЫ — users.json (не старый config.json): так пересборка
# восстанавливает юзеров даже если config.json пуст/перегенерирован.
apply_all(){
  local clients tmp cnt=0
  # tmp с расширением .json: xray run -test определяет формат по расширению,
  # без .json -> "Failed to get format" (rc=23) и пересборка падает.
  clients=$(mktemp); tmp=$(mktemp --suffix=.json)
  jq '[to_entries[] | {id:.value.uuid, email:.key}]' "$USERS" > "$clients"
  VEIL_ENV="$META" python3 "$GENSERVER" --clients "$clients" > "$tmp"
  rm -f "$clients"
  xray run -test -c "$tmp" >/dev/null 2>&1 || { rm -f "$tmp"; die "серверный конфиг невалиден — изменения НЕ применены"; }
  write_json "$tmp" "$CONF"
  while IFS=$'\t' read -r uuid token; do
    [ -n "$token" ] && [ "$token" != "null" ] && { regen_one "$uuid" "$token"; cnt=$((cnt+1)); }
  done < <(jq -r 'to_entries[] | "\(.value.uuid)\t\(.value.token)"' "$USERS")
  echo "  >> пересобрано: серверный конфиг + профилей $cnt"
  reload_xray
  # Caddy раздаёт файлы подписок вживую с диска — рестарт не нужен, только reload на всякий
  systemctl reload caddy 2>/dev/null || true
}

cmd_create(){
  local name="${1:-}"; [ -n "$name" ] || die "имя: veil create-key <имя>"
  if key_exists "$name"; then die "ключ '$name' уже есть (veil show-key $name)"; fi
  local uuid token tmp
  uuid=$(xray uuid 2>/dev/null || cat /proc/sys/kernel/random/uuid)
  token=$(openssl rand -hex 16)
  tmp=$(mktemp)
  jq --arg id "$uuid" --arg n "$name" \
     '(.inbounds[] | select(.tag=="obychny" or .tag=="usilenny") | .settings.clients) += [{"id":$id,"email":$n}]' \
     "$CONF" > "$tmp"; write_json "$tmp" "$CONF"
  reload_xray
  regen_one "$uuid" "$token"
  tmp=$(mktemp)
  jq --arg n "$name" --arg id "$uuid" --arg t "$token" '. + {($n): {"uuid":$id,"token":$t}}' "$USERS" > "$tmp"
  write_json "$tmp" "$USERS"
  echo -e "${GREEN}OK ключ '$name' создан${NC}"
  show_all "$token" "$name" "$uuid"
}

cmd_delete(){
  local name="${1:-}"; [ -n "$name" ] || die "имя: veil delete-key <имя>"
  if ! key_exists "$name"; then die "ключа '$name' нет"; fi
  local token tmp
  token=$(jq -r --arg n "$name" '.[$n].token' "$USERS")
  tmp=$(mktemp)
  jq --arg n "$name" \
     '(.inbounds[] | select(.tag=="obychny" or .tag=="usilenny") | .settings.clients) |= map(select(.email != $n))' \
     "$CONF" > "$tmp"; write_json "$tmp" "$CONF"
  reload_xray
  [ -n "$token" ] && [ "$token" != "null" ] && rm -f "$SUBDIR/$token"
  tmp=$(mktemp); jq --arg n "$name" 'del(.[$n])' "$USERS" > "$tmp"; write_json "$tmp" "$USERS"
  echo -e "${GREEN}OK ключ '$name' удалён${NC}"
}

cmd_list(){
  local n; n=$(jq -r 'length' "$USERS")
  echo -e "${CY}${BOLD}Ключей: $n${NC}"
  jq -r 'to_entries[] | "  - \(.key)\t\(.value.uuid)"' "$USERS"
}

cmd_show(){
  local name="${1:-}"; [ -n "$name" ] || die "имя: veil show-key <имя>"
  if ! key_exists "$name"; then die "ключа '$name' нет"; fi
  local token uuid
  token=$(jq -r --arg n "$name" '.[$n].token' "$USERS")
  uuid=$(jq -r --arg n "$name" '.[$n].uuid' "$USERS")
  show_all "$token" "$name" "$uuid"
}

# альтернатива подписке: два голых vless://-ключа (без РУ-сплита)
cmd_keys(){
  local name="${1:-}"; [ -n "$name" ] || die "имя: veil keys <имя>"
  if ! key_exists "$name"; then die "ключа '$name' нет (создай: veil create-key $name)"; fi
  local uuid; uuid=$(jq -r --arg n "$name" '.[$n].uuid' "$USERS")
  echo
  echo -e "${CY}${BOLD}Два vless-ключа '$name' (вставь в happ как конфиги):${NC}"
  vless_links "$uuid"
  echo
  echo -e "${YEL}  !! Это упрощённый импорт: РУ-сайты пойдут ЧЕРЕЗ VPN (без split-routing),${NC}"
  echo -e "${YEL}     extra-тюнинг packet-up/xmux на дефолтах. Полный профиль — через подписку (veil show-key $name).${NC}"
}

# sync — лёгкое обновление: git pull свежего кода/маршрутов + пересборка.
# БЕЗ переустановки Xray-core (безопасно гонять по таймеру). Бережно к простою:
# apply_all делает xray run -test перед применением — кривой конфиг НЕ применится.
cmd_sync(){
  echo -e "${CY}${BOLD}>> veil sync${NC}"
  if [ -n "${REPO_DIR:-}" ] && [ -d "$REPO_DIR/.git" ]; then
    echo "  >> git pull ($REPO_DIR)"
    git -C "$REPO_DIR" pull --ff-only >/dev/null 2>&1 || echo "  !! git pull не прошёл (не критично)"
    for f in genprofile.py genserver.py routes.json; do
      [ -f "$REPO_DIR/$f" ] && install -m 644 "$REPO_DIR/$f" "$VEIL/$f"
    done
    [ -f "$REPO_DIR/veil" ] && install -m 755 "$REPO_DIR/veil" /usr/local/bin/veil
  else
    echo "  !! REPO_DIR не задан — пропускаю git pull"
  fi
  apply_all
  echo -e "${GREEN}OK sync завершён${NC}"
}

cmd_update(){
  echo -e "${CY}${BOLD}>> Обновление veil (полное: Xray-core + код + конфиг)${NC}"
  echo "  >> обновляю Xray-core"
  bash -c "$(curl -L https://github.com/XTLS/Xray-install/raw/main/install-release.sh)" @ install >/dev/null 2>&1 || echo "  !! не удалось обновить Xray (не критично)"
  cmd_sync
  echo -e "${GREEN}OK обновление завершено${NC}"
}

cmd_set_sni(){
  local sni="${1:-}"; [ -n "$sni" ] || die "укажи домен-маску: veil set-sni <домен>  (напр. www.samsung.com)"
  echo -e "${CY}${BOLD}>> Меняю маскировочный SNI на: $sni${NC}"
  set_env_var SNI "$sni"
  . "$META"
  apply_all
  echo -e "${GREEN}OK SNI = $sni${NC}"
  echo -e "${YEL}  !! Пользователям нужно обновить подписку в happ (или дождаться автообновления),${NC}"
  echo -e "${YEL}     чтобы клиент перешёл на новый SNI. До этого их подключение не пройдёт.${NC}"
}

cmd_status(){
  echo -e "${CY}${BOLD}veil status${NC}"
  echo "  Xray:     $(systemctl is-active xray 2>/dev/null) ($(xray version 2>/dev/null | head -1 || echo '?'))"
  echo "  Caddy:    $(systemctl is-active caddy 2>/dev/null)  (подписка https://${SUB_HOST}/sub/...)"
  echo "  Сервер:   ${SRV_IP}"
  echo "  Порты:    [Обычный] :${PORT_OB}  [Усиленный] :${PORT_US}"
  echo "  Ключей:   $(jq -r 'length' "$USERS")"
  local ct cm
  ct=$(cat /proc/sys/net/netfilter/nf_conntrack_count 2>/dev/null || echo '?')
  cm=$(cat /proc/sys/net/netfilter/nf_conntrack_max 2>/dev/null || echo '?')
  echo "  Conntrack:${ct}/${cm}"
  for p in "$PORT_OB" "$PORT_US" "$SUB_PORT"; do
    ss -tlnH "( sport = :$p )" 2>/dev/null | grep -q . && echo "  port :$p  LISTEN" || echo "  port :$p  НЕ слушает!"
  done
}

case "${1:-}" in
  create-key) shift; cmd_create "${1:-}";;
  delete-key) shift; cmd_delete "${1:-}";;
  list-keys|list) cmd_list;;
  show-key)   shift; cmd_show "${1:-}";;
  keys)       shift; cmd_keys "${1:-}";;
  sync)       cmd_sync;;
  update)     cmd_update;;
  set-sni)    shift; cmd_set_sni "${1:-}";;
  status)     cmd_status;;
  *) cat <<USAGE
veil — управление VPN-нодой

  veil create-key <имя>   создать ключ, показать ссылку-подписку + QR
  veil delete-key <имя>   удалить ключ
  veil list-keys          список ключей
  veil show-key <имя>     показать ссылку-подписку + QR
  veil keys <имя>         два голых vless-ключа (альтернатива, БЕЗ РУ-сплита)
  veil sync               git pull кода/маршрутов + пересборка (без Xray-core; для авто-обновления)
  veil update             полное обновление: Xray-core + sync
  veil set-sni <домен>    сменить маскировочный SNI (напр. www.samsung.com)
  veil status             состояние ноды (сервисы, порты, ключи)

Каждый ключ = подписка с 2 профилями:
  [Обычный]   -- мобильный интернет (3G/4G/5G)
  [Усиленный] -- Wi-Fi и более жёсткие блокировки
РУ-сайты ходят напрямую мимо VPN (split-routing, обновляемый список).
USAGE
  ;;
esac
